{
  "name": "example-conditional-sections",
  "version": "v2026.10.1",
  "specVersion": 27,
  "derivedFrom": null,
  "templating": {
    "engine": "scriban",
    "engineVersion": "7.2.5"
  },
  "description": "A demonstration of what specVersion 27 opened — a flow node inside a for: a case on each section's kind drafts narrative sections as prose and table sections as a table and skips the rest, an if with no else writes a patient-facing line for the narrative sections alone, and an if over a folder of standing sections holds the billing section back unless asked. Not intended for clinical use.",
  "inputs": [
    {
      "id": "consult_draft",
      "label": "Consult draft",
      "required": true
    },
    {
      "id": "sections",
      "label": "Sections to produce",
      "required": true,
      "type": "array",
      "items": "object",
      "fields": [
        {
          "id": "title",
          "label": "Title",
          "required": true,
          "type": "text"
        },
        {
          "id": "kind",
          "label": "Kind",
          "required": true,
          "type": "enum",
          "values": [
            "narrative",
            "table",
            "omit"
          ]
        },
        {
          "id": "notes",
          "label": "Notes for this section",
          "required": false,
          "type": "text"
        }
      ]
    },
    {
      "id": "include_billing",
      "label": "Include the billing section",
      "required": false,
      "type": "boolean"
    }
  ],
  "nodes": [
    {
      "id": "sections_draft",
      "label": "Sections — drafting each requested section by its kind",
      "for": "item in input.sections",
      "nodes": [
        "route"
      ],
      "ret": "node.route"
    },
    {
      "id": "route",
      "label": "Routing a section by its kind",
      "case": "item.value.kind",
      "branches": [
        {
          "when": [
            "narrative"
          ],
          "nodes": [
            "narrative_draft"
          ],
          "ret": "node.narrative_draft"
        },
        {
          "when": [
            "table"
          ],
          "nodes": [
            "table_draft"
          ],
          "ret": "node.table_draft"
        }
      ]
    },
    {
      "id": "narrative_draft",
      "label": "Drafting a narrative section",
      "prompt": "prompts/narrative-section.md",
      "format": "prose"
    },
    {
      "id": "table_draft",
      "label": "Drafting a table section",
      "prompt": "prompts/table-section.md",
      "format": "prose"
    },
    {
      "id": "patient_summaries",
      "label": "Sections — one patient-facing line per narrative section",
      "for": "item in input.sections",
      "nodes": [
        "narrative_only"
      ],
      "ret": "node.narrative_only"
    },
    {
      "id": "narrative_only",
      "label": "Narrative sections only",
      "if": "item.value.kind == \"narrative\"",
      "then": {
        "nodes": [
          "patient_summary"
        ],
        "ret": "node.patient_summary"
      }
    },
    {
      "id": "patient_summary",
      "label": "Writing the patient-facing line",
      "prompt": "prompts/patient-summary.md",
      "format": "prose"
    },
    {
      "id": "standing_sections",
      "label": "Standing sections — tailored to this consult",
      "for": "item in snippet.sections",
      "nodes": [
        "applies"
      ],
      "ret": "node.applies"
    },
    {
      "id": "applies",
      "label": "Holding the billing section back unless asked",
      "if": "item.id != \"billing\" || input.include_billing == true",
      "then": {
        "nodes": [
          "standing_draft"
        ],
        "ret": "node.standing_draft"
      }
    },
    {
      "id": "standing_draft",
      "label": "Tailoring a standing section",
      "prompt": "prompts/standing-section.md",
      "format": "prose"
    },
    {
      "id": "coverage",
      "label": "Naming the sections left out",
      "prompt": "prompts/coverage.md",
      "format": "prose"
    }
  ],
  "tags": [],
  "deliverables": [
    {
      "id": "consult_note",
      "label": "Consult note",
      "sources": [
        "node.sections_draft",
        "node.standing_sections",
        "node.coverage"
      ]
    },
    {
      "id": "patient_summary",
      "label": "Patient summary",
      "sources": [
        "node.patient_summaries"
      ]
    }
  ],
  "snippets": {
    "sections": "snippets/sections/"
  }
}
