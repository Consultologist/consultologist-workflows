{
  "name": "example-classifier-scope",
  "version": "v2026.10.2",
  "specVersion": 25,
  "derivedFrom": null,
  "title": "Scope classifier demo",
  "description": "A demonstration of what specVersion 10 opened: a classifier reads the referral and answers in_scope, out_of_scope or needs_information; the package then produces a plan, a decline letter or a request for further information — one document, decided at the boundary rather than asked at intake. Not intended for clinical use.",
  "tags": [
    "demo",
    "classifier"
  ],
  "templating": {
    "engine": "scriban",
    "engineVersion": "7.2.5"
  },
  "inputs": [
    {
      "id": "consult_draft",
      "label": "Consult draft",
      "required": true
    }
  ],
  "prompts": [
    {
      "id": "classify_scope",
      "file": "prompts/classify-scope.md"
    },
    {
      "id": "plan_section",
      "file": "prompts/plan-section.md"
    },
    {
      "id": "decline_letter",
      "file": "prompts/decline-letter.md"
    },
    {
      "id": "information_request",
      "file": "prompts/information-request.md"
    }
  ],
  "macros": [
    {
      "id": "closing",
      "label": "Closing note",
      "file": "macros/closing.md",
      "instruction": "The closing goes at the end of the decline letter, as its final paragraph."
    }
  ],
  "nodes": [
    {
      "id": "scope",
      "label": "Is the referral in scope?",
      "prompt": "classify_scope",
      "format": "classification",
      "with": {
        "values": [
          "in_scope",
          "out_of_scope",
          "needs_information"
        ]
      },
      "onInvalid": "fail"
    },
    {
      "id": "plan_section",
      "forEach": "snippet.plan_sections",
      "label": "Drafting the plan",
      "prompt": "plan_section",
      "format": "prose"
    },
    {
      "id": "decline_letter",
      "forEach": "snippet.letter",
      "label": "Drafting the decline letter",
      "prompt": "decline_letter",
      "format": "prose"
    },
    {
      "id": "information_request",
      "forEach": "snippet.letter",
      "label": "Drafting the request for information",
      "prompt": "information_request",
      "format": "prose"
    },
    {
      "id": "assemble_plan",
      "label": "Assembling the plan",
      "aggregate": [
        "node.plan_section"
      ]
    },
    {
      "id": "assemble_decline_letter",
      "label": "Assembling the decline letter",
      "aggregate": [
        "node.decline_letter"
      ]
    },
    {
      "id": "assemble_information_request",
      "label": "Assembling the request for information",
      "aggregate": [
        "node.information_request"
      ]
    }
  ],
  "deliverables": [
    {
      "id": "plan",
      "node": "node.assemble_plan",
      "label": "Plan",
      "when": "node.scope.value == \"in_scope\""
    },
    {
      "id": "decline_letter",
      "node": "node.assemble_decline_letter",
      "label": "Decline letter",
      "when": "node.scope.value == \"out_of_scope\"",
      "macros": [
        {
          "id": "closing",
          "at": "append"
        }
      ],
      "signature": true
    },
    {
      "id": "information_request",
      "node": "node.assemble_information_request",
      "label": "Request for information",
      "when": "node.scope.value == \"needs_information\""
    }
  ],
  "snippets": {
    "letter": "snippets/letter/",
    "plan_sections": "snippets/plan_sections/"
  }
}
