flowchart TD
    snippet_plan_sections(["snippet.plan_sections"])
    snippet_letter(["snippet.letter"])

    scope["scope<br/>Is the referral in scope?"]
    assemble_plan["assemble_plan<br/>Assembling the plan<br/>aggregate"]
    plan_section -->|"aggregate"| assemble_plan
    assemble_decline_letter["assemble_decline_letter<br/>Assembling the decline letter<br/>aggregate"]
    decline_letter -->|"aggregate"| assemble_decline_letter
    assemble_information_request["assemble_information_request<br/>Assembling the request for information<br/>aggregate"]
    information_request -->|"aggregate"| assemble_information_request

    snippet_plan_sections -->|"forEach"| foreach_snippet_plan_sections
    subgraph foreach_snippet_plan_sections["per snippet.plan_sections item"]
        plan_section["plan_section<br/>Drafting the plan"]
    end

    snippet_letter -->|"forEach"| foreach_snippet_letter
    subgraph foreach_snippet_letter["per snippet.letter item"]
        decline_letter["decline_letter<br/>Drafting the decline letter"]
        information_request["information_request<br/>Drafting the request for information"]
    end
