flowchart TD
    snippet_plan_sections(["snippet.plan_sections"])
    snippet_letter(["snippet.letter"])

    scope["scope<br/>Is the referral in scope?"]

    snippet_plan_sections -->|"for"| for_plan_sections
    subgraph for_plan_sections["plan_sections: per snippet.plan_sections item"]
        plan_section["plan_section<br/>Drafting the plan"]
    end
    plan_sections["plan_sections<br/>Plan sections<br/>item in snippet.plan_sections"]
    plan_section -->|"ret"| plan_sections

    snippet_letter -->|"for"| for_letter_decline_letter
    subgraph for_letter_decline_letter["letter_decline_letter: per snippet.letter item"]
        decline_letter["decline_letter<br/>Drafting the decline letter"]
    end
    letter_decline_letter["letter_decline_letter<br/>Letter — drafting the decline letter<br/>item in snippet.letter"]
    decline_letter -->|"ret"| letter_decline_letter

    snippet_letter -->|"for"| for_letter_information_request
    subgraph for_letter_information_request["letter_information_request: per snippet.letter item"]
        information_request["information_request<br/>Drafting the request for information"]
    end
    letter_information_request["letter_information_request<br/>Letter — drafting the request for information<br/>item in snippet.letter"]
    information_request -->|"ret"| letter_information_request

    result_plan{{"plan<br/>Plan"}}
    plan_sections --> result_plan
    result_decline_letter{{"decline_letter<br/>Decline letter"}}
    letter_decline_letter --> result_decline_letter
    result_information_request{{"information_request<br/>Request for information"}}
    letter_information_request --> result_information_request
