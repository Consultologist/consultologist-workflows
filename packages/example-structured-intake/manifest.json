{
  "name": "example-structured-intake",
  "version": "v2026.10.1",
  "specVersion": 25,
  "derivedFrom": null,
  "title": "Structured intake demo",
  "description": "A demonstration of what specVersion 9 opened: an array of prior notes fanned per element (leave it empty to see the empty-fan refusal), a patient object read by path, a number driving an ordering comparison, and a deliverable gated on count(). Not intended for clinical use.",
  "tags": [
    "demo",
    "structured-intake"
  ],
  "templating": {
    "engine": "scriban",
    "engineVersion": "7.2.5"
  },
  "inputs": [
    {
      "id": "consult_draft",
      "label": "Consult draft",
      "required": true
    },
    {
      "id": "prior_notes",
      "label": "Prior notes",
      "required": false,
      "type": "array",
      "items": "text"
    },
    {
      "id": "patient",
      "label": "Patient record",
      "required": false,
      "type": "object",
      "fields": [
        {
          "id": "age",
          "label": "Age",
          "type": "number"
        },
        {
          "id": "sex",
          "label": "Sex",
          "required": false,
          "type": "enum",
          "values": [
            "female",
            "male"
          ]
        }
      ]
    },
    {
      "id": "length_of_stay",
      "label": "Length of stay (days)",
      "required": false,
      "type": "number"
    }
  ],
  "prompts": [
    {
      "id": "note_section",
      "file": "prompts/note-section.md"
    },
    {
      "id": "senior_review_section",
      "file": "prompts/senior-review-section.md"
    },
    {
      "id": "long_stay_section",
      "file": "prompts/long-stay-section.md"
    },
    {
      "id": "summarise_note",
      "file": "prompts/summarise-note.md"
    },
    {
      "id": "index_note",
      "file": "prompts/index-note.md"
    }
  ],
  "nodes": [
    {
      "id": "note_section",
      "forEach": "snippet.sections",
      "label": "Drafting the note",
      "prompt": "note_section",
      "format": "prose"
    },
    {
      "id": "senior_review_section",
      "forEach": "snippet.sections",
      "label": "Drafting the senior review request",
      "prompt": "senior_review_section",
      "format": "prose"
    },
    {
      "id": "long_stay_section",
      "forEach": "snippet.sections",
      "label": "Drafting the long-stay summary",
      "prompt": "long_stay_section",
      "format": "prose"
    },
    {
      "id": "summarise_note",
      "forEach": "input.prior_notes",
      "label": "Summarising a prior note",
      "prompt": "summarise_note",
      "format": "prose"
    },
    {
      "id": "assemble_note",
      "label": "Assembling the consultation note",
      "aggregate": [
        "node.note_section"
      ]
    },
    {
      "id": "assemble_senior_review",
      "label": "Assembling the senior review request",
      "aggregate": [
        "node.senior_review_section"
      ]
    },
    {
      "id": "assemble_long_stay",
      "label": "Assembling the long-stay summary",
      "aggregate": [
        "node.long_stay_section"
      ]
    },
    {
      "id": "index_note",
      "forEach": "input.prior_notes",
      "label": "Indexing a prior note",
      "prompt": "index_note",
      "format": "prose"
    },
    {
      "id": "assemble_digest",
      "label": "Assembling the prior-notes digest",
      "aggregate": [
        "node.summarise_note"
      ]
    },
    {
      "id": "assemble_index",
      "label": "Assembling the prior-notes index",
      "aggregate": [
        "node.index_note"
      ]
    }
  ],
  "deliverables": [
    {
      "id": "note",
      "node": "node.assemble_note",
      "label": "Consultation note"
    },
    {
      "id": "senior_review",
      "node": "node.assemble_senior_review",
      "label": "Senior review request",
      "when": "input.patient.age >= 65"
    },
    {
      "id": "long_stay_summary",
      "node": "node.assemble_long_stay",
      "label": "Long-stay summary",
      "when": "input.length_of_stay > 7"
    },
    {
      "id": "notes_digest",
      "node": "node.assemble_digest",
      "label": "Prior-notes digest"
    },
    {
      "id": "notes_index",
      "node": "node.assemble_index",
      "label": "Prior-notes index",
      "when": "(input.prior_notes | array.size) > 2"
    }
  ],
  "snippets": {
    "sections": "snippets/sections/"
  }
}
