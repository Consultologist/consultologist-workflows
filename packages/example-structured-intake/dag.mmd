flowchart TD
    snippet_sections(["snippet.sections"])
    input_prior_notes(["input.prior_notes"])
    input_patient(["input:patient"])
    input_length_of_stay(["input:length_of_stay"])
    input_prior_notes(["input:prior_notes"])

    assemble_note["assemble_note<br/>Assembling the consultation note<br/>aggregate"]
    note_section -->|"aggregate"| assemble_note
    assemble_senior_review["assemble_senior_review<br/>Assembling the senior review request<br/>aggregate"]
    senior_review_section -->|"aggregate"| assemble_senior_review
    assemble_long_stay["assemble_long_stay<br/>Assembling the long-stay summary<br/>aggregate"]
    long_stay_section -->|"aggregate"| assemble_long_stay
    assemble_digest["assemble_digest<br/>Assembling the prior-notes digest<br/>aggregate"]
    summarise_note -->|"aggregate"| assemble_digest
    assemble_index["assemble_index<br/>Assembling the prior-notes index<br/>aggregate"]
    index_note -->|"aggregate"| assemble_index

    snippet_sections -->|"forEach"| foreach_snippet_sections
    subgraph foreach_snippet_sections["per snippet.sections item"]
        note_section["note_section<br/>Drafting the note"]
        senior_review_section["senior_review_section<br/>Drafting the senior review request"]
        long_stay_section["long_stay_section<br/>Drafting the long-stay summary"]
    end

    input_prior_notes -->|"forEach"| foreach_input_prior_notes
    subgraph foreach_input_prior_notes["per input.prior_notes item"]
        summarise_note["summarise_note<br/>Summarising a prior note"]
        index_note["index_note<br/>Indexing a prior note"]
    end
