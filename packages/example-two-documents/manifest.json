{
  "name": "example-two-documents",
  "version": "v2026.10.3",
  "specVersion": 27,
  "derivedFrom": "general@v2026.07.9",
  "templating": {
    "engine": "scriban",
    "engineVersion": "7.2.5"
  },
  "inputs": [
    {
      "id": "consult_draft",
      "label": "Consult draft",
      "required": true
    },
    {
      "id": "prior_notes",
      "label": "Prior notes",
      "required": false
    }
  ],
  "nodes": [
    {
      "id": "extract_patient_concepts",
      "label": "Extracting clinical concepts",
      "prompt": "prompts/extract-patient-concepts.md",
      "format": "concept_list",
      "onInvalid": "fail",
      "failIfEmpty": "The consult could not be processed because clinical concepts could not be extracted from the draft."
    },
    {
      "id": "identify_problem",
      "label": "Identifying primary problem",
      "prompt": "prompts/identify-problem.md",
      "format": "concept_list",
      "onInvalid": "fail",
      "failIfEmpty": "No valid disease or problem concept was identified."
    },
    {
      "id": "create_typical_trajectory",
      "label": "Building reference trajectory",
      "prompt": "prompts/create-typical-trajectory.md",
      "format": "concept_list",
      "onInvalid": "fail",
      "failIfEmpty": "No valid typical trajectory concepts were generated."
    },
    {
      "id": "create_patient_trajectory",
      "label": "Building patient trajectory",
      "prompt": "prompts/create-patient-trajectory.md",
      "format": "concept_list",
      "onInvalid": "fail",
      "failIfEmpty": "No valid patient trajectory concepts were generated."
    },
    {
      "id": "standard_section_draft",
      "label": "Drafting section",
      "prompt": "prompts/standard-section-draft.md",
      "format": "prose"
    },
    {
      "id": "patient_section_draft",
      "label": "Applying patient information",
      "prompt": "prompts/patient-section-draft.md",
      "format": "prose"
    },
    {
      "id": "standards",
      "label": "Standards",
      "for": "item in snippet.standards",
      "nodes": [
        "section_instructions",
        "patient_section_draft",
        "standard_section_draft"
      ],
      "ret": "node.section_instructions"
    },
    {
      "id": "section_instructions",
      "label": "Applying section instructions",
      "prompt": "prompts/section-instructions.md",
      "format": "prose"
    },
    {
      "id": "draft_patient_letter",
      "label": "Writing the patient letter",
      "prompt": "prompts/draft-patient-letter.md",
      "format": "prose"
    }
  ],
  "tags": [],
  "deliverables": [
    {
      "id": "consult_note",
      "label": "Consultation note",
      "sources": [
        "node.standards"
      ]
    },
    {
      "id": "patient_letter",
      "label": "Patient letter",
      "sources": [
        "node.draft_patient_letter"
      ]
    }
  ],
  "snippets": {
    "snomed_tool_guidance": "snippets/snomed_tool_guidance.md",
    "standards": "snippets/standards/",
    "specialty": "snippets/specialty.md",
    "note_type": "snippets/note_type.md"
  }
}
