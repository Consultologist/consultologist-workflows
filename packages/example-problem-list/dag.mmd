flowchart TD
    snippet_sections(["snippet.sections"])

    find_problems["find_problems<br/>Finding the problems"]
    follow_up["follow_up<br/>Is a reassessment arranged?"]

    find_problems -->|"for"| for_problems
    subgraph for_problems["problems: per node.find_problems.value.problems item"]
        draft_problem["draft_problem<br/>Drafting the problem"]
    end
    problems["problems<br/>Problems<br/>item in node.find_problems.value.problems"]
    draft_problem -->|"ret"| problems

    snippet_sections -->|"for"| for_sections
    subgraph for_sections["sections: per snippet.sections item"]
        section_draft["section_draft<br/>Drafting the section"]
    end
    sections["sections<br/>Standing sections<br/>item in snippet.sections"]
    section_draft -->|"ret"| sections
    follow_up -.->|"if"| section_draft
    follow_up -.->|"if"| sections

    result_note{{"note<br/>Problem-oriented note"}}
    sections --> result_note
    problems --> result_note
