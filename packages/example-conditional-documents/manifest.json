{
  "name": "example-conditional-documents",
  "version": "v2026.10.3",
  "specVersion": 27,
  "derivedFrom": null,
  "templating": {
    "engine": "scriban",
    "engineVersion": "7.2.5"
  },
  "inputs": [
    {
      "id": "consult_draft",
      "label": "Consult draft",
      "required": true
    },
    {
      "id": "seen_on",
      "label": "Date seen",
      "required": true,
      "type": "date"
    },
    {
      "id": "encounter_kind",
      "label": "Encounter kind",
      "required": false,
      "type": "enum",
      "values": [
        "new_patient",
        "follow_up"
      ]
    },
    {
      "id": "include_billing",
      "label": "Include a billing sentence",
      "required": false,
      "type": "boolean"
    }
  ],
  "nodes": [
    {
      "id": "sections_consult_note_section",
      "label": "Sections \u2014 drafting the consultation note",
      "for": "item in snippet.sections",
      "nodes": [
        "consult_note_section"
      ],
      "ret": "node.consult_note_section"
    },
    {
      "id": "consult_note_section",
      "label": "Drafting the consultation note",
      "prompt": "prompts/consult-note-section.md",
      "format": "prose"
    },
    {
      "id": "sections_progress_note_section",
      "label": "Sections \u2014 drafting the progress note",
      "for": "item in snippet.sections",
      "nodes": [
        "progress_note_section"
      ],
      "ret": "node.progress_note_section"
    },
    {
      "id": "progress_note_section",
      "label": "Drafting the progress note",
      "prompt": "prompts/progress-note-section.md",
      "format": "prose"
    }
  ],
  "tags": [],
  "deliverables": [
    {
      "id": "consult_note",
      "label": "Consultation note",
      "sources": [
        "node.sections_consult_note_section"
      ],
      "if": "input.encounter_kind == \u0022new_patient\u0022"
    },
    {
      "id": "progress_note",
      "label": "Progress note",
      "sources": [
        "node.sections_progress_note_section"
      ],
      "if": "input.encounter_kind == \u0022follow_up\u0022"
    }
  ],
  "snippets": {
    "sections": "snippets/sections/"
  }
}
