{
  "name": "example-conditional-documents",
  "version": "v2026.10.1",
  "specVersion": 25,
  "derivedFrom": null,
  "templating": {
    "engine": "scriban",
    "engineVersion": "7.2.5"
  },
  "inputs": [
    {
      "id": "consult_draft",
      "label": "Consult draft",
      "required": true
    },
    {
      "id": "seen_on",
      "label": "Date seen",
      "required": true,
      "type": "date"
    },
    {
      "id": "encounter_kind",
      "label": "Encounter kind",
      "required": false,
      "type": "enum",
      "values": [
        "new_patient",
        "follow_up"
      ]
    },
    {
      "id": "include_billing",
      "label": "Include a billing sentence",
      "required": false,
      "type": "boolean"
    }
  ],
  "prompts": [
    {
      "id": "consult_note_section",
      "file": "prompts/consult-note-section.md"
    },
    {
      "id": "progress_note_section",
      "file": "prompts/progress-note-section.md"
    }
  ],
  "nodes": [
    {
      "id": "consult_note_section",
      "forEach": "snippet.sections",
      "label": "Drafting the consultation note",
      "prompt": "consult_note_section",
      "format": "prose"
    },
    {
      "id": "progress_note_section",
      "forEach": "snippet.sections",
      "label": "Drafting the progress note",
      "prompt": "progress_note_section",
      "format": "prose"
    },
    {
      "id": "assemble_consult_note",
      "label": "Assembling the consultation note",
      "aggregate": [
        "node.consult_note_section"
      ]
    },
    {
      "id": "assemble_progress_note",
      "label": "Assembling the progress note",
      "aggregate": [
        "node.progress_note_section"
      ]
    }
  ],
  "tags": [],
  "deliverables": [
    {
      "id": "consult_note",
      "node": "node.assemble_consult_note",
      "label": "Consultation note",
      "when": "input.encounter_kind == \"new_patient\""
    },
    {
      "id": "progress_note",
      "node": "node.assemble_progress_note",
      "label": "Progress note",
      "when": "input.encounter_kind == \"follow_up\""
    }
  ],
  "snippets": {
    "sections": "snippets/sections/"
  }
}
